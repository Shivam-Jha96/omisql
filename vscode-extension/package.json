{
  "name": "omnisql-vscode",
  "displayName": "OmniSQL",
  "description": "Blazing-fast SQL linter and language server",
  "version": "0.1.3",
  "publisher": "omnisql",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Shivam-Jha96/omnisql.git"
  },
  "license": "MIT",
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sql",
        "aliases": ["SQL"],
        "extensions": [".sql"]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "OmniSQL",
      "properties": {
        "omnisql.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the OmniSQL Language Server."
        },
        "omnisql.executablePath": {
          "type": "string",
          "default": "omnisql",
          "description": "Path to the omnisql executable (default: 'omnisql', uses PATH)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
